---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Newsletter from "@components/Newsletter.astro";
import CourseCard from "@components/CourseCard.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { formatPostDate, toIsoDate } from "@utils/formatPostDate";
import { coursesByNextSession } from "@data/teaching";

const sorted = getSortedPosts(await getCollection("blog"));

/**
 * The lead is the newest featured post, falling back to the newest post so the
 * section never empties. Rows are simply the next most recent pieces: the old
 * homepage rendered `featured` posts only, so a new post could be published and
 * never appear here at all until someone remembered to flag it.
 */
const lead = sorted.find(({ data }) => data.featured) ?? sorted[0];
const rows = sorted.filter(post => post.id !== lead?.id).slice(0, 4);
---

<Layout title="Sajal Sharma | AI Engineer | O'Reilly Instructor">
  <Header />
  <main id="main-content">
    <!-- Hero copy is provisional. The kicker, headline and link labels are
         settled; the body paragraph is a placeholder Sajal intends to rewrite
         in the content epic, which will revisit this page. It is factually
         correct as it stands — no current-employer claim — so it is safe to
         ship in the meantime, but do not treat it as final wording. -->
    <section id="hero" data-track="home-hero">
      <p class="hero-kicker">AI Engineer &middot; O'Reilly Instructor</p>
      <h1 class="hero-title">I build AI systems and teach engineers how.</h1>
      <p class="hero-body">
        Eight years shipping machine learning and NLP &mdash; search ranking,
        natural-language interfaces to databases, and chatbots serving tens of
        thousands daily, most recently agents and RAG at a Temasek-backed
        venture studio. I teach what I ship: four O'Reilly courses on agents and
        RAG.
      </p>
      <p class="hero-ctas">
        <a href="/posts">Read my blog</a>
        <a href="/teaching">Take my courses</a>
        <a href="/about">About Me</a>
      </p>
    </section>

    <section id="writing" data-track="featured-posts">
      <h2 class="section-heading">Writing</h2>
      {
        lead && (
          <a class="lead" href={`/posts/${lead.id}`}>
            <h3 class="lead-title">{lead.data.title}</h3>
            <p class="lead-deck">{lead.data.description}</p>
          </a>
        )
      }
      <ul class="rows">
        {
          rows.map(post => (
            <li>
              <a href={`/posts/${post.id}`}>
                <time
                  class="row-date"
                  datetime={toIsoDate(post.data.pubDatetime)}
                >
                  {formatPostDate(post.data.pubDatetime)}
                </time>
                <span class="row-title">{post.data.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="more" data-track="home-all-posts">
        <a href="/posts">All writing &rarr;</a>
      </p>
    </section>

    <section id="teaching" data-track="courses">
      <h2 class="section-heading">Teaching</h2>
      <ul class="course-grid">
        {coursesByNextSession().map(course => <CourseCard course={course} />)}
      </ul>
      <p class="more" data-track="home-all-teaching">
        <a href="/teaching">All teaching &rarr;</a>
      </p>
    </section>

    <Newsletter />
  </main>

  <Footer />
</Layout>

<style>
  /* The page shell is the header's, so the hero starts on the same vertical as
     the logo above it; the reading measure is applied to the prose inside it
     (.hero-title, .hero-body, .lead-*) rather than to the page. Holding the
     whole page at 40rem kept summaries honest but squeezed the row list and the
     course grid — two 288px cards — into a column sized for one, and left the
     content floating 172px inside the rules that bracket it. */
  #main-content {
    @apply mx-auto w-full max-w-shell px-4 pb-4 pt-8 sm:px-6;
  }
  /* base.css gives every `section` its own max-width and padding; here the main
     element already owns both, and leaving the section padding on would indent
     the content 16px inside a column that is already the right width. */
  #main-content > section {
    @apply max-w-none px-0;
  }

  /* ===== Hero ===== */
  .hero-kicker {
    @apply mb-4 font-mono text-skin-muted;
    font-size: 0.8125rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  /* Both clamped to the measure inside the wider shell: the headline is written
     to break after "and", and across the full shell it straightens into one
     44px line that runs the width of the page. */
  .hero-title {
    @apply max-w-measure;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .hero-body {
    @apply max-w-measure;
    font-size: 1.125rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  /* Mono, underlined in accent: the same voice the post kicker and the archive
     rows speak in, so the page's first interactive elements read as navigation
     rather than as prose links. No arrow — these are destinations, not "more". */
  .hero-ctas {
    @apply mt-7 flex flex-wrap gap-x-6 gap-y-2 font-mono;
    font-size: 0.875rem;
  }
  .hero-ctas a {
    @apply text-skin-base no-underline transition-colors hover:text-skin-accent;
    border-bottom: 1px solid rgba(var(--color-accent), 0.4);
    padding-bottom: 2px;
  }
  .hero-ctas a:hover {
    border-bottom-color: rgb(var(--color-accent));
  }

  /* ===== Writing ===== */
  .lead {
    @apply block no-underline;
  }
  /* The lead post is a block of prose — title over summary — so both keep the
     measure. Left unclamped the summary ran to 120 characters while the rows
     beneath it stayed short, and the two stopped reading as one section. */
  .lead-title {
    @apply max-w-measure text-skin-base transition-colors;
    font-size: 1.625rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .lead:hover .lead-title {
    @apply text-skin-accent;
  }
  .lead-deck {
    @apply mt-2 max-w-measure text-skin-muted;
    font-size: 1.0625rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .rows {
    @apply mt-8 border-t border-skin-line;
  }
  .rows li {
    @apply border-b border-skin-line;
  }
  /* The date column carries the year here, unlike the archive, whose rows sit
     under a year heading. This list spans years with no such grouping, so a
     2025 post showed as "Jul 27" directly beneath "Jan 2" and read as though
     the sort was broken. 6.75rem fits "Sep 27, 2025" without wrapping. */
  .rows a {
    @apply grid items-baseline gap-x-5 gap-y-1 py-3 no-underline;
    grid-template-columns: minmax(0, 1fr);
  }
  /* Two columns only where there is room for both. On a 375px screen the date
     column took 31% of the width and squeezed titles to three lines, so below
     the breakpoint the date sits above the title instead. */
  @media (min-width: 640px) {
    .rows a {
      grid-template-columns: 6.75rem minmax(0, 1fr);
    }
  }
  .row-date {
    @apply font-mono text-skin-muted;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .row-title {
    @apply font-serif font-normal text-skin-base transition-colors;
    font-size: 1.1875rem;
    line-height: 1.35;
  }
  .rows a:hover .row-title {
    @apply text-skin-accent;
  }
  .more {
    @apply mt-6 font-mono;
    font-size: 0.875rem;
  }
  .more a {
    @apply text-skin-base no-underline transition-colors hover:text-skin-accent;
    border-bottom: 1px solid rgba(var(--color-accent), 0.4);
    padding-bottom: 2px;
  }

  /* ===== Teaching ===== */
  /* The card itself lives in CourseCard.astro, which owns its own styles, so
     /teaching and this page cannot drift. Only the grid around it is local,
     because the two pages space their cards differently. */
  .course-grid {
    @apply grid gap-x-8 gap-y-6;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 640px) {
    .course-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { formatPostDate, toIsoDate } from "@utils/formatPostDate";
import { SITE } from "@config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
---

<Layout title={`Posts | ${SITE.title}`}>
  <Header activeNav="posts" />
  <Main
    pageTitle="Posts"
    pageDesc="Here I document my experiments with AI engineering, insights from building intelligent systems and share deep dives on latest paradigms."
  >
    <ul class="posts-list" data-track="posts-list">
      {
        sortedPosts.map(({ data, id }) => (
          <li class="post-item">
            <time class="post-date" datetime={toIsoDate(data.pubDatetime)}>
              {formatPostDate(data.pubDatetime)}
            </time>
            <span class="post-separator">»</span>
            <a href={`/posts/${id}`} class="post-title">
              {data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>

<style>
  .posts-list {
    @apply m-0 list-none p-0;
  }

  .post-item {
    @apply mb-2 flex items-start;
  }

  .post-date {
    @apply mr-2 whitespace-nowrap text-skin-base opacity-70;
  }

  .post-separator {
    @apply mr-2 text-skin-base opacity-70;
  }

  .post-title {
    @apply text-skin-accent no-underline;
  }

  .post-title:hover {
    @apply underline;
  }
</style>

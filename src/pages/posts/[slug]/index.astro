---
import { type CollectionEntry, getCollection } from "astro:content";
import PostDetails from "@layouts/PostDetails.astro";

export interface Props {
  post: CollectionEntry<"blog">;
}

/**
 * Posts only. This route used to return page numbers alongside slugs and render
 * a paginated card list for /posts/1../posts/4 — a second, unlinked copy of the
 * archive that only crawlers and the sitemap ever saw. /posts is one complete
 * index now, so those pages are gone.
 */
export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<PostDetails post={post} />

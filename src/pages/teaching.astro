---
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import CourseCard from "@components/CourseCard.astro";
import {
  MENTORSHIP,
  TALKS,
  coursesByNextSession,
  formatTalkDate,
  isUpcomingTalk,
} from "@data/teaching";
import { SITE } from "@config";

const courses = coursesByNextSession();
---

<Layout
  title={`Teaching | ${SITE.title}`}
  description="O'Reilly courses on AI agents and RAG, guest lectures at Yale, and mentoring — taught by an engineer who ships the systems behind them."
>
  <Header activeNav="teaching" />
  <Main pageTitle="Teaching">
    <section class="page-section" data-track="teaching-courses">
      <h2 class="section-heading">Courses</h2>
      <p class="section-intro">
        Courses published through O'Reilly, with upcoming live sessions listed
        below.
      </p>
      <ul class="course-grid">
        {courses.map(course => <CourseCard course={course} detail="full" />)}
      </ul>
    </section>

    <section class="page-section" data-track="teaching-talks">
      <h2 class="section-heading">Guest Lectures &amp; Talks</h2>
      <ul class="entry-list">
        {
          TALKS.map(talk => (
            <li class="entry">
              <p class="entry-meta">
                <span>{formatTalkDate(talk)}</span>
                {isUpcomingTalk(talk) && <span class="badge">upcoming</span>}
              </p>
              {/* A talk announced before its programme is published has no
                  title yet, so the venue carries the row instead. */}
              <h3 class="entry-title">{talk.title ?? talk.venue}</h3>
              <p class="entry-host">
                {talk.title ? talk.venue : "Conference talk"}
                {talk.hostCourse && ` · ${talk.hostCourse}`}
              </p>
              {talk.summary && <p class="entry-summary">{talk.summary}</p>}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="page-section" data-track="teaching-mentorship">
      <h2 class="section-heading">Mentoring</h2>
      <ul class="entry-list">
        {
          MENTORSHIP.map(entry => (
            <li class="entry">
              <p class="entry-meta">
                <span>{entry.years}</span>
              </p>
              <h3 class="entry-title">{entry.org}</h3>
              <p class="entry-summary">{entry.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Restoring a route this page used to have. The Enquiries block was
         removed ahead of /contact existing, which left the page most likely to
         produce a workshop enquiry pointing nowhere but the footer.
         It names the private-workshop offer here rather than only handing off,
         which is the removed block's argument and still the right one: someone
         who has read this far already knows the work, and making them navigate
         elsewhere to discover that private sessions exist loses them.
         `section-label`, not `section-heading` — a mono utility label is the
         rank this block held before and the one the newsletter holds too. A
         28px serif heading with an accent marker would announce a fourth
         section of the page rather than close it.
         data-track keeps the retired `teaching-contact` value rather than
         taking a new one, so the numbers stay comparable to the old block's. -->
    <section class="page-section contact-block" data-track="teaching-contact">
      <h2 class="section-label">Private Workshops</h2>
      <p class="section-intro">
        I also run these courses as private sessions for engineering teams,
        shaped around what the team is building. <a href="/contact/"
          >Get in touch</a
        > if that would be useful for yours.
      </p>
    </section>
  </Main>
  <Footer />
</Layout>

<style>
  /* .page-section, .section-intro and the .entry-* record vocabulary now live
     in base.css, shared with /about — the two pages are the same kind of page
     and were drifting apart while each kept its own copy. Only what is genuinely
     specific to teaching is left here.

     Courses keep the two-column card grid the homepage uses; this page differs
     by listing every sitting inside each card rather than just the next one.
     Talks and mentoring below are full-width lists — neither has a link to
     click, and both read as a short history rather than a schedule. */
  /* The first heading on this page opens the content; the ones below it divide
     it. The accent marker and the 3.2rem above it both say "a section ended and
     another began", which is true of Guest Lectures and Mentoring and not of
     Courses — nothing precedes it but the page title, so the two together read
     as two openings stacked, "Teaching" and then "Courses" again. Dropping both
     leaves the page head's own bottom margin to set the gap.
     Deliberately scoped here rather than added to .section-heading in base.css:
     on /about the first heading follows a resume link and two paragraphs of
     prose, so there it marks a real transition and keeps its marker. */
  .page-section:first-of-type .section-heading {
    margin-top: 0;
  }
  .page-section:first-of-type .section-heading::before {
    display: none;
  }
  .course-grid {
    @apply mt-6 grid gap-x-8 gap-y-6;
    grid-template-columns: minmax(0, 1fr);
  }
  /* The same rule .entry:first-child drops in base.css, for the one list on
     this page that is a grid: the top row's hairlines ran under the heading
     block and read as an underline on it. It is the first *row* that clears,
     not the first card, so the count tracks the column count below — one card
     on mobile, two once the grid splits. :global because .course-card is
     CourseCard's own root element and never carries this page's scope. */
  .course-grid > :global(.course-card:first-child) {
    @apply border-t-0 pt-0;
  }
  @media (min-width: 640px) {
    .course-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .course-grid > :global(.course-card:nth-child(-n + 2)) {
      @apply border-t-0 pt-0;
    }
  }
  /* .section-label carries no margin of its own — .section-heading's 3.2rem is
     what sets every other boundary on this page, and a mono label deliberately
     does not have it. So this block sets its own, and takes rather less than a
     full section break: it closes the page rather than opening a fourth part
     of it. Same reasoning, and the same value, as About's closing line. */
  .contact-block {
    margin-top: 2rem;
  }
  /* Only talks carry this: a sitting still ahead of the build date. */
  .badge {
    @apply rounded-sm border border-skin-line px-1.5 py-0.5;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
  }
</style>

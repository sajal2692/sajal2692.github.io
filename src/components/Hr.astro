---
export interface Props {
  noPadding?: boolean;
  ariaHidden?: boolean;
  /** Span the full page shell (header rule) rather than the content column. */
  wide?: boolean;
}

const { noPadding = false, ariaHidden = true, wide = false } = Astro.props;
---

<div
  class={`mx-auto ${wide ? "max-w-shell sm:px-6" : "max-w-3xl"} ${noPadding ? "px-0" : "px-4"}`}
>
  <hr class="border-skin-line" aria-hidden={ariaHidden} />
</div>

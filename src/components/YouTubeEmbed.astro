---
export interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${id}`;
---

<figure class="session-video" data-track="post-video">
  <youtube-embed data-video-id={id} data-video-title={title}>
    <a
      class="video-poster focus-outline"
      href={watchUrl}
      aria-label={`Play video: ${title}`}
    >
      <img
        src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`}
        alt=""
        width="1280"
        height="720"
        decoding="async"
      />
      <span class="play-control" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
          <path d="M8 5v14l11-7z"></path>
        </svg>
        Play session
      </span>
    </a>
  </youtube-embed>
  <figcaption>
    O’Reilly Zero to Agent session · <a href={watchUrl}>Watch on YouTube</a>
  </figcaption>
</figure>

<script>
  class YouTubeEmbed extends HTMLElement {
    connectedCallback() {
      const poster = this.querySelector<HTMLAnchorElement>(".video-poster");
      if (!poster || poster.dataset.ready) return;
      poster.dataset.ready = "true";
      poster.setAttribute("role", "button");
      poster.addEventListener("keydown", event => {
        if (event.key === " ") {
          event.preventDefault();
          poster.click();
        }
      });
      poster.addEventListener("click", event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          return;
        event.preventDefault();
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${this.dataset.videoId}?autoplay=1&playsinline=1`;
        iframe.title = this.dataset.videoTitle ?? "YouTube video";
        iframe.allow =
          "autoplay; encrypted-media; picture-in-picture; fullscreen";
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        this.replaceChildren(iframe);
        iframe.focus();
      });
    }
  }

  if (!customElements.get("youtube-embed")) {
    customElements.define("youtube-embed", YouTubeEmbed);
  }
</script>

<style>
  .session-video {
    @apply mt-9;
  }
  youtube-embed {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    /* Keep the player above YouTube's minimum height on narrow screens. */
    min-height: 200px;
    background: #000;
  }
  .video-poster {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }
  .video-poster img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .play-control {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.85rem;
    border-radius: 0.3rem;
    background: #111;
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
  }
  .video-poster:hover .play-control,
  .video-poster:focus-visible .play-control {
    background: #c00;
  }
  youtube-embed :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 200px;
    border: 0;
  }
  figcaption {
    @apply mt-3 text-sm text-skin-muted;
  }
  figcaption a {
    @apply text-skin-accent underline underline-offset-4;
  }
</style>

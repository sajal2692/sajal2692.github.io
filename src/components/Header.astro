---
import { LOGO_IMAGE, SITE } from "@config";
import Hr from "./Hr.astro";
import LinkButton from "./LinkButton.astro";
import LogoSVG from "@assets/logo";

export interface Props {
  activeNav?: "posts" | "teaching" | "about" | "search";
}

const { activeNav } = Astro.props;

// Three destinations, in the order they matter: what I write, what I teach,
// who I am. Tags left the nav — a tag index is a way to filter the writing,
// not a fourth place to go — and is reachable from the footer and from the
// tag chips on every post. Tag pages mark Writing active for that reason.
const NAV_ITEMS = [
  { href: "/posts", label: "Writing", key: "posts" },
  { href: "/teaching", label: "Teaching", key: "teaching" },
  { href: "/about", label: "About Me", key: "about" },
] as const;
---

<header data-track="header">
  <a id="skip-to-content" href="#main-content">Skip to content</a>
  <div class="nav-container">
    <div class="top-nav-wrap">
      <a href="/" class="logo whitespace-nowrap">
        {
          LOGO_IMAGE.enable ? (
            // <img
            //   src={`/assets/${LOGO_IMAGE.svg ? "logo.svg" : "logo.png"}`}
            //   alt={SITE.title}
            //   width={LOGO_IMAGE.width}
            //   height={LOGO_IMAGE.height}
            // />
            <LogoSVG />
          ) : (
            SITE.title
          )
        }
      </a>

      <nav id="nav-menu">
        <button
          class="hamburger-menu focus-outline"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="icon menu-icon"
          >
            <line x1="7" y1="12" x2="21" y2="12" class="line"></line>
            <line x1="3" y1="6" x2="21" y2="6" class="line"></line>
            <line x1="12" y1="18" x2="21" y2="18" class="line"></line>
            <line x1="18" y1="6" x2="6" y2="18" class="close"></line>
            <line x1="6" y1="6" x2="18" y2="18" class="close"></line>
          </svg>
        </button>
        <ul id="menu-items" class="display-none sm:flex">
          {
            NAV_ITEMS.map(item => (
              <li>
                <a
                  href={item.href}
                  class:list={["nav-link", { active: activeNav === item.key }]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <!-- Search and the theme toggle share one row: they are controls, not
               destinations, and grouping them keeps the mobile menu a plain
               stack that any number of nav items can grow into. -->
          <li class="menu-actions">
            <!-- The active state has to ride a utility class, not a scoped
                 descendant rule: LinkButton's anchor is another component's
                 root, so it never receives this component's scope attribute and
                 such a rule silently matches nothing. -->
            <LinkButton
              href="/search"
              className={`focus-outline flex p-3 transition-colors sm:p-1 ${
                activeNav === "search"
                  ? "text-skin-base"
                  : "text-skin-muted hover:text-skin-base"
              }`}
              ariaLabel="search"
              title="Search"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="icon"
                ><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"
                ></path><path d="M21 21l-6 -6"></path>
              </svg>
              <span class="sr-only">Search</span>
            </LinkButton>
            {
              SITE.lightAndDarkMode && (
                <button
                  id="theme-btn"
                  class="focus-outline"
                  title="Toggles light & dark"
                  aria-label="auto"
                  aria-live="polite"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="icon"
                    id="moon-svg"
                  >
                    <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" />
                  </svg>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="icon"
                    id="sun-svg"
                  >
                    <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                    <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" />
                  </svg>
                </button>
              )
            }
          </li>
        </ul>
      </nav>
    </div>
  </div>
  <Hr wide />
</header>

<style>
  #skip-to-content {
    @apply absolute -top-full left-16 z-50 bg-skin-accent px-3 py-2 text-skin-inverted transition-all focus:top-4;
  }
  /* max-w-shell (and the matching sm:px-6) keeps the nav and its rule flush with
     the article's outer edges, rail included. */
  .nav-container {
    @apply mx-auto flex max-w-shell flex-col items-center justify-between sm:flex-row;
  }
  .top-nav-wrap {
    @apply relative flex w-full items-start justify-between p-4 sm:items-center sm:px-6 sm:py-8;
  }
  /* Serif, like every page H1: the wordmark is display type, and it was the
     only display element on the site still set in the body sans. */
  .logo {
    @apply absolute py-1 font-serif text-xl font-semibold sm:static sm:text-2xl;
    letter-spacing: -0.01em;
  }
  .hamburger-menu {
    @apply self-end p-3 text-skin-base sm:hidden;
  }

  nav {
    @apply flex w-full flex-col items-center sm:ml-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0;
  }
  /* Element selectors, not a class: `.display-none` toggles the mobile menu and
     a class here would tie its specificity and win, leaving the menu open. */
  nav ul {
    @apply mt-4 flex w-44 flex-col sm:ml-0 sm:mt-0 sm:w-auto sm:flex-row sm:items-center sm:gap-5;
  }
  nav ul li {
    @apply flex items-center justify-center;
  }
  /* Was a two-column grid with a hardcoded row count, positioning the last two
     cells by nth-last-child — so the layout silently depended on there being
     exactly five items, and swapping one nav entry for another was the most
     it could survive. A stack has no such arithmetic. */
  .menu-actions {
    @apply gap-1 sm:gap-2;
  }
  /* Muted at 16px, resolving to full ink on hover. These were 18px in ink —
     body-copy size and body-copy weight — so the chrome read level with the
     writing it frames. Hover goes to base rather than the accent used
     elsewhere: a whole row of links flashing teal on every pass of the mouse
     is exactly the noise this treatment is meant to remove.
     Mobile keeps 18px; there the menu is the only thing on screen. */
  .nav-link {
    @apply block w-full px-4 py-3 text-center text-lg font-medium text-skin-muted transition-colors hover:text-skin-base sm:w-auto sm:px-2 sm:py-1 sm:text-base;
  }
  /* The active item is the one nav link in full ink; the accent is spent on the
     underline alone. */
  nav a.active {
    @apply text-skin-base underline decoration-1 underline-offset-4;
    text-decoration-color: rgb(var(--color-accent));
  }

  /* The toggle is a control, not a destination, so it takes the same muted ->
     ink resolve as the links and the search glyph beside it. The 12deg rotate
     on hover went with the socials' 6deg one. */
  #theme-btn {
    @apply p-3 text-skin-muted transition-colors hover:text-skin-base sm:p-1;
  }

  .menu-icon line {
    @apply transition-opacity duration-75 ease-in-out;
  }
  .menu-icon .close {
    opacity: 0;
  }
  .menu-icon.is-active .line {
    @apply opacity-0;
  }
  .menu-icon.is-active .close {
    @apply opacity-100;
  }
</style>

<script>
  function toggleNav() {
    // Toggle menu
    const menuBtn = document.querySelector(".hamburger-menu");
    const menuIcon = document.querySelector(".menu-icon");
    const menuItems = document.querySelector("#menu-items");

    menuBtn?.addEventListener("click", () => {
      const menuExpanded = menuBtn.getAttribute("aria-expanded") === "true";
      menuIcon?.classList.toggle("is-active");
      menuBtn.setAttribute("aria-expanded", menuExpanded ? "false" : "true");
      menuBtn.setAttribute(
        "aria-label",
        menuExpanded ? "Open Menu" : "Close Menu"
      );
      menuItems?.classList.toggle("display-none");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>

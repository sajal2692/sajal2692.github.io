---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer
  class={`footer-shell ${noMarginTop ? "" : "mt-auto"}`}
  data-track="footer"
>
  <!-- wide + noPadding: the shell's own padding is already applied by
       .footer-shell, so the rule spans its inner width, matching the header's. -->
  <Hr wide noPadding />
  <div class="footer-wrapper">
    <Socials centered />
    <div class="copyright-wrapper">
      <span>Copyright &#169; {currentYear}</span>
      <span class="separator">&nbsp;|&nbsp;</span>
      <span>All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  footer {
    @apply w-full;
  }
  /* The class (not the element) carries the width so it beats the global
     `section, footer { max-w-3xl }` in base.css. Footer chrome spans the same
     shell as the header, so the rules bracketing a page are the same length —
     they were 936px at the top and 736px at the bottom. */
  .footer-shell {
    @apply mx-auto max-w-shell px-4 sm:px-6;
  }
  .footer-wrapper {
    @apply flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4;
  }
  .copyright-wrapper {
    @apply my-2 flex flex-col items-center whitespace-nowrap sm:flex-row;
  }
  .separator {
    @apply hidden sm:inline;
  }
</style>

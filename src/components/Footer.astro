---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;

// Only what the header does not already carry. Tags and the feed are ways back
// into the writing for someone who already reads it, not destinations the
// primary nav has to advertise — tags left the nav in this redesign and would
// otherwise be reachable only from the chips on a post. Echoing Writing,
// Teaching and About down here just said the same three things twice.
const FOOTER_NAV = [
  { href: "/tags", label: "Tags" },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer
  class={`footer-shell ${noMarginTop ? "" : "mt-auto"}`}
  data-track="footer"
>
  <!-- wide + noPadding: the shell's own padding is already applied by
       .footer-shell, so the rule spans its inner width, matching the header's. -->
  <Hr wide noPadding />
  <div class="footer-wrapper">
    <div class="footer-bottom">
      <!-- Socials carry their own data-track, so every link left directly under
           the footer section is one of these — no extra attribute needed to
           tell the nav echo apart in GA4. -->
      <div class="footer-links">
        <nav class="footer-nav" aria-label="Footer">
          {FOOTER_NAV.map(item => <a href={item.href}>{item.label}</a>)}
        </nav>
        <Socials />
      </div>
      <p class="copyright">&copy; {currentYear} Sajal Sharma</p>
    </div>
  </div>
</footer>

<style>
  footer {
    @apply w-full;
  }
  /* The class (not the element) carries the width so it beats the global
     `section, footer { max-w-3xl }` in base.css. Footer chrome spans the same
     shell as the header, so the rules bracketing a page are the same length —
     they were 936px at the top and 736px at the bottom. */
  .footer-shell {
    @apply mx-auto max-w-shell px-4 sm:px-6;
  }
  .footer-wrapper {
    @apply py-8;
  }
  /* One band, so the wrapper's own padding is all the space there is: an mt here
     would stack on top of it and push a single row of 12px type a long way
     below the rule that closes the page. */
  .footer-bottom {
    @apply flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between;
  }
  /* Nav echo and socials read as one row of words. They stay two elements only
     so GA4 can tell an outbound profile link from a link back into the site;
     the gap between the groups matches the gap inside them, because a seam the
     eye can see would be a distinction the reader does not need. */
  .footer-links {
    @apply flex flex-wrap items-center gap-x-5 gap-y-2;
  }
  .footer-nav {
    @apply flex flex-wrap gap-x-5 gap-y-2;
  }
  /* Mono uppercase: the same furniture voice as section labels, post dates and
     the hero kicker. */
  .footer-nav a {
    @apply font-mono uppercase text-skin-muted no-underline transition-colors hover:text-skin-base;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  .copyright {
    @apply font-mono text-skin-muted;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
</style>

---

<!-- mt-0: the step above this section belongs to its .section-heading, which
     keeps it equal to Read Next's above it. -->
<section id="newsletter" class="mb-8 mt-0 p-0">
  <h2 class="section-heading">Newsletter</h2>
  <p class="newsletter-intro">
    Sign up to get updates on my latest posts, projects and insights on AI & ML.
    You'll only receive an email when I publish something new.
  </p>
  <div class="mt-4">
    <script src="https://f.convertkit.com/ckjs/ck.5.js" is:inline></script>
    <form
      id="newsletter-form"
      action="https://app.kit.com/forms/8036304/subscriptions"
      class="seva-form formkit-form"
      method="post"
      data-sv-form="8036304"
      data-uid="2d16cff56e"
      data-format="inline"
      data-version="5"
      style="max-width: 700px; border-radius: 4px;"
    >
      <div style="padding: 0;">
        <ul
          class="formkit-alert formkit-alert-error"
          data-element="errors"
          data-group="alert"
        >
        </ul>
        <div
          id="newsletter-form-fields"
          data-element="fields"
          data-stacked="false"
          class="mt-1 flex items-center gap-2"
        >
          <div class="formkit-field flex-grow">
            <input
              class="formkit-input w-full rounded-md border border-skin-line px-4 py-2"
              name="email_address"
              aria-label="Email Address"
              placeholder="Email Address"
              required
              type="email"
            />
          </div>
          <button
            data-element="submit"
            class="formkit-submit subscribe-btn rounded-md px-4 py-2 font-medium transition-colors"
          >
            <span>Subscribe</span>
          </button>
        </div>
        <div
          id="success-message"
          class="success-msg mt-4 hidden rounded-md p-3"
        >
          <p class="text-center">
            Thanks for subscribing! <strong
              >Please check your email to confirm your subscription.</strong
            >
          </p>
        </div>
      </div>
    </form>
  </div>
</section>

<style>
  /* Everything here is token-driven — the form used to hardcode five hex values
     (two blues, two greens and a grey) that matched neither theme. */
  /* Full measure, no 52ch clamp: at this column width the clamp broke two
     sentences into three short ragged lines under a 28px heading. */
  .newsletter-intro {
    @apply mt-5;
    text-wrap: pretty;
  }
  .subscribe-btn {
    background-color: rgb(var(--color-accent));
    color: rgb(var(--color-fill));
  }
  .subscribe-btn:hover {
    background-color: rgba(var(--color-accent), 0.88);
  }

  .formkit-input {
    background-color: rgb(var(--color-fill));
    color: rgb(var(--color-text-base));
  }
  .formkit-input::placeholder {
    color: rgba(var(--color-muted), 0.9);
  }

  /* Success state as a quiet accent tint rather than the old hardcoded greens,
     which read as a different site in either theme. */
  .success-msg {
    background-color: rgba(var(--color-accent), 0.08);
    color: rgb(var(--color-text-base));
    border: 1px solid rgba(var(--color-accent), 0.35);
  }
</style>

<script is:inline>
  // Wait for DOM to be fully loaded
  document.addEventListener("DOMContentLoaded", function () {
    // Find all newsletter forms on the page
    const forms = document.querySelectorAll("#newsletter-form");

    forms.forEach(form => {
      // Handle form submissions
      form.addEventListener("submit", function () {
        // GA4 conversion event; gtag.js runs on the main thread (see
        // Layout.astro) and picks this up from the shared dataLayer.
        window.dataLayer = window.dataLayer || [];
        var gtag = function () {
          window.dataLayer.push(arguments);
        };
        gtag("event", "newsletter_signup");

        // Get the form fields and success message elements
        const formFields = form.querySelector("#newsletter-form-fields");
        const successMessage = form.querySelector("#success-message");

        // ConvertKit form submission handler
        setTimeout(function () {
          // Check if the form was successfully submitted (no visible error message)
          const errorEl = form.querySelector(".formkit-alert-error");
          if (errorEl && errorEl.children.length === 0) {
            // Hide the form fields and show the success message
            if (formFields && successMessage) {
              formFields.style.display = "none";
              successMessage.classList.remove("hidden");
            }
          }
        }, 1000); // Short delay to allow form processing
      });
    });
  });
</script>

---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li class="inline-block">
  <a
    href={`/tags/${tag}`}
    transition:name={tag}
    class={`tag-chip ${size === "lg" ? "tag-chip-lg" : ""}`}
  >
    {tag}
  </a>
</li>

<style>
  /* Quiet mono chips. The old version was a hashtag SVG plus four &nbsp; to
     clear it, underlined and set at body size — a fourth metadata treatment on
     a page that already had enough. */
  .tag-chip {
    @apply inline-block rounded border border-skin-line font-mono text-skin-muted no-underline transition-colors;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.45rem;
  }
  .tag-chip:hover {
    @apply border-skin-accent text-skin-accent;
    border-color: rgba(var(--color-accent), 0.45);
  }
  .tag-chip-lg {
    font-size: 0.8125rem;
    padding: 0.3rem 0.6rem;
  }
</style>

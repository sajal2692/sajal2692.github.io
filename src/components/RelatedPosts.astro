---
import type { CollectionEntry } from "astro:content";
import Card from "@components/Card";

export interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section
      id="related-posts"
      aria-labelledby="related-posts-heading"
      data-track="related-posts"
    >
      <h2 id="related-posts-heading" class="section-heading">
        Read Next
      </h2>
      <ul>
        {posts.map(post => (
          <Card
            href={`/posts/${post.id}/`}
            frontmatter={post.data}
            secHeading={false}
          />
        ))}
      </ul>
    </section>
  )
}

<style>
  /* No padding at all: the step above the rule and the rule itself belong to
     .section-heading, and any padding here would block the margin collapse that
     keeps that step equal to the newsletter's below (margins never collapse into
     padding — that is where the old 88px gap came from). px-0 cancels the global
     section px-4 (base.css), which would double-pad inside main's own px-4 and
     shift the section off the article edge. */
  #related-posts {
    @apply p-0;
  }
  /* .section-heading itself lives in base.css @layer components — the newsletter
     below uses the same marker, so the post footer reads as one system. */
</style>

---
import type { CollectionEntry } from "astro:content";
import Card from "@components/Card";

export interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section
      id="related-posts"
      aria-labelledby="related-posts-heading"
      data-track="related-posts"
    >
      <h2 id="related-posts-heading" class="section-label">
        Read Next
      </h2>
      <ul>
        {posts.map(post => (
          <Card
            href={`/posts/${post.id}/`}
            frontmatter={post.data}
            secHeading={false}
          />
        ))}
      </ul>
    </section>
  )
}

<style>
  /* No top padding: the 48px step above this section is owned by the preceding
     .post-meta block's margin, so padding here would stack on top of it (margins
     never collapse into padding) — that is where the old 88px gap came from.
     Cards below bring their own my-6. px-0 cancels the global section px-4
     (base.css), which would double-pad inside main's own px-4 and shift the
     section off the article edge. */
  #related-posts {
    @apply px-0 pb-2 pt-0;
  }
  /* .section-label itself lives in base.css @layer components — the newsletter
     below uses the same marker, so the post footer reads as one system. */
</style>

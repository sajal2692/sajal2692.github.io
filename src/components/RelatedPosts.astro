---
import type { CollectionEntry } from "astro:content";
import Card from "@components/Card";

export interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section
      id="related-posts"
      aria-labelledby="related-posts-heading"
      data-track="related-posts"
    >
      <h2 id="related-posts-heading" class="section-label">
        Read Next
      </h2>
      <ul>
        {posts.map(post => (
          <Card
            href={`/posts/${post.id}/`}
            frontmatter={post.data}
            secHeading={false}
          />
        ))}
      </ul>
    </section>
  )
}

<style>
  /* pt-12 gives the heading the same 48px rhythm article h2s get from
     mt-12 (the article's last child carries no bottom margin). Cards below
     bring their own my-6. px-0 cancels the global section px-4 (base.css),
     which would double-pad inside main's own px-4 and shift the section
     off the article edge. */
  #related-posts {
    @apply px-0 pb-2 pt-12;
  }
  /* A section outside the article gets the mono label treatment, not an article
     h2 — the accent bar this used to carry is exactly the tell being retired. */
  .section-label {
    @apply flex items-center gap-4 font-mono font-medium text-skin-muted;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .section-label::after {
    content: "";
    @apply h-px flex-1 bg-skin-line;
  }
</style>

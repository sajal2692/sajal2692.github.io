---
import { type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import Pagination from "@components/Pagination.astro";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
  /** Every post carrying the tag, not just this page's slice — the kicker counts them. */
  totalPosts: number;
  tag: string;
  tagName: string;
}

const { currentPage, totalPages, paginatedPosts, totalPosts, tag, tagName } =
  Astro.props;
---

<Layout title={`Tag: ${tagName} | ${SITE.title}`}>
  <Header activeNav="posts" />
  <!-- The tag itself is the title: the kicker above already says what it is, so
       a "Tag:" or "Tagged" prefix would only repeat it, and reads oddly against
       a slug like ai-engineering. -->
  <Main
    pageTitle={tagName}
    titleTransition={tag}
    kicker={[
      "Tag",
      `${totalPosts} ${totalPosts === 1 ? "post" : "posts"}`,
      totalPages > 1 && `page ${currentPage} of ${totalPages}`,
    ]}
  >
    <div slot="backlink" class="tag-nav" data-track="post-nav">
      <a href="/tags/" class="back-link">&larr; All tags</a>
    </div>
    <ul data-track="posts-list">
      {
        paginatedPosts.map(({ data, id }) => (
          <Card href={`/posts/${id}`} frontmatter={data} />
        ))
      }
    </ul>
  </Main>

  <style>
    /* Same treatment as a post page's "All posts" link, so every page that can
       be backed out of does it the same way. */
    .back-link {
      @apply -mt-2 mb-6 inline-block font-mono text-sm text-skin-muted no-underline transition-colors hover:text-skin-base;
      letter-spacing: 0.02em;
    }
  </style>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/tags/${tag}${
      currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
    }`}
    nextUrl={`/tags/${tag}/${currentPage + 1}`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>

---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import getRelatedPosts from "@utils/getRelatedPosts";
import getReadingTime from "@utils/getReadingTime";
import ShareLinks from "@components/ShareLinks.astro";
import Newsletter from "@components/Newsletter.astro";
import RelatedPosts from "@components/RelatedPosts.astro";
import { LOCALE } from "@config";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content, headings } = await render(post);

const allPosts = await getCollection("blog");
const relatedPosts = getRelatedPosts(allPosts, post.id);

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;

const layoutProps = {
  title,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};

const readingTime = getReadingTime(post.body ?? "");

const formatDate = (value: string | Date) =>
  new Date(value).toLocaleDateString(LOCALE.langTag, {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

// The kicker's topic is the first tag, hyphens out. It stays lowercase in the
// markup and is uppercased by CSS, which keeps acronyms like "ai" correct.
const primaryTopic = tags?.[0]?.replace(/-/g, " ");

// The in-body table of contents (remark-toc) stays for narrow screens; the rail
// is built from render()'s headings so it can live outside the prose column.
const railHeadings = headings.filter(
  ({ depth, slug }) => depth >= 2 && depth <= 3 && slug !== "table-of-contents"
);
---

<Layout {...layoutProps}>
  <!-- Add Katex Stylesheet to render Latex code correctly -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css"
    integrity="sha384-MlJdn/WNKDGXveldHDdyRP1R4CTHr3FeuDNfhsLPYrq2t0UBkUdK2jyTnXPEK1NQ"
    crossorigin="anonymous"
  />

  <Header />

  <main id="main-content">
    <div class="article-shell">
      <div data-track="post-nav">
        <a href="/posts" class="back-link">&larr; All posts</a>
      </div>

      <div class="article-grid">
        <div class="article-main">
          <p class="post-kicker">
            <span>{formatDate(pubDatetime)}</span>
            <span>{readingTime} min read</span>
            {primaryTopic && <span>{primaryTopic}</span>}
          </p>

          <h1 transition:name={slugifyStr(title)} class="post-title">
            {title}
          </h1>

          {description && <p class="post-deck">{description}</p>}

          <article
            id="article"
            role="article"
            class="prose"
            data-track="post-body"
          >
            <Content />
          </article>

          <p class="post-dates">
            <span>Published {formatDate(pubDatetime)}</span>
            {modDatetime && <span>Updated {formatDate(modDatetime)}</span>}
          </p>

          <ul class="tag-list" data-track="post-tags">
            {tags.map(tag => <Tag tag={slugifyStr(tag)} />)}
          </ul>

          <RelatedPosts posts={relatedPosts} />

          <Newsletter />

          <div class="post-footer-actions">
            <button
              id="back-to-top"
              class="focus-outline whitespace-nowrap py-1 hover:text-skin-accent"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="rotate-90">
                <path
                  d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
                ></path>
              </svg>
              <span>Back to Top</span>
            </button>

            <ShareLinks />
          </div>
        </div>

        {
          railHeadings.length > 0 && (
            <aside class="toc-rail" aria-labelledby="toc-rail-label">
              <p id="toc-rail-label" class="toc-rail-label">
                On this page
              </p>
              <nav>
                <ol>
                  {railHeadings.map(({ depth, slug, text }) => (
                    <li>
                      <a href={`#${slug}`} class={depth === 3 ? "sub" : ""}>
                        {text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>
          )
        }
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* max-w-shell is sized to the grid it holds — measure (640) + gap (72) + rail
     (224) + 48px of padding — so the pair centres with equal margins instead of
     leaving slack to the right of the rail. */
  .article-shell {
    @apply mx-auto w-full max-w-shell px-4 pb-12 sm:px-6;
  }
  .back-link {
    @apply mb-8 mt-8 inline-block font-mono text-sm text-skin-muted no-underline transition-colors hover:text-skin-accent;
    letter-spacing: 0.02em;
  }

  /* The text column and the rail are centred together as a pair, so the reading
     column sits a little left of centre on wide screens. */
  .article-grid {
    @apply grid;
    gap: 4.5rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 1080px) {
    .article-grid {
      grid-template-columns: theme("maxWidth.measure") 14rem;
    }
  }
  .article-main {
    @apply max-w-measure;
  }

  /* ===== Title block ===== */
  .post-kicker {
    @apply mb-4 flex flex-wrap gap-x-2 gap-y-1 font-mono text-skin-muted;
    font-size: 0.8125rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .post-kicker span:not(:last-child)::after {
    content: " ·";
  }
  .post-title {
    @apply font-serif font-semibold;
    font-size: clamp(2rem, 5vw, 2.875rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: 0 0 0.85rem;
    text-wrap: balance;
  }
  .post-deck {
    @apply text-skin-muted;
    font-size: 1.25rem;
    line-height: 1.5;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .article-main :global(.prose) {
    @apply mt-9;
  }

  /* ===== Below the body ===== */
  .post-dates {
    @apply mt-12 flex flex-wrap gap-x-2 border-t border-skin-line pt-5 font-mono text-skin-muted;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .post-dates span:not(:last-child)::after {
    content: " ·";
  }
  .tag-list {
    @apply mb-10 mt-4 flex flex-wrap gap-x-1;
  }
  .post-footer-actions {
    @apply mb-8 mt-12 flex flex-col-reverse items-center justify-between gap-6 sm:flex-row-reverse sm:items-end sm:gap-4;
  }

  /* ===== Sticky TOC rail (>= lg only) ===== */
  .toc-rail {
    @apply hidden;
  }
  @media (min-width: 1080px) {
    .toc-rail {
      @apply block self-start;
      position: sticky;
      top: 3rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
    .toc-rail-label {
      @apply mb-3 font-mono text-skin-muted;
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .toc-rail ol {
      @apply m-0 list-none border-l border-skin-line p-0;
    }
    .toc-rail a {
      @apply -ml-px block border-l-2 border-transparent py-1.5 pl-3 pr-1 text-sm leading-snug text-skin-muted no-underline transition-colors;
    }
    .toc-rail a:hover {
      @apply text-skin-base;
    }
    .toc-rail a.sub {
      @apply pl-6 text-[0.8125rem];
    }
    .toc-rail a[aria-current="true"] {
      @apply border-skin-accent text-skin-accent;
    }
  }
</style>

<script is:inline>
  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    // Article sections only. Section headings elsewhere on the page (Read Next)
    // have ids for aria-labelledby, not for sharing, and their styling lives
    // outside .prose — a permalink there just renders a stray "#".
    let headings = Array.from(
      document.querySelectorAll(
        "#article h2, #article h3, #article h4, #article h5, #article h6"
      )
    );
    for (let heading of headings) {
      if (!heading.id) continue;
      if (heading.querySelector(".heading-link")) continue;
      let link = document.createElement("a");
      link.innerText = "#";
      link.className = "heading-link";
      link.href = "#" + heading.id;
      // Focusable on purpose (it appears on keyboard focus as well as hover),
      // so it needs a real label rather than aria-hidden.
      link.setAttribute("aria-label", `Permalink to “${heading.textContent}”`);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();
  document.addEventListener("astro:after-swap", addHeadingLinks);

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. The language label is CSS-only
   * (pre[data-language]), so it survives without JS. */
  function attachCopyButtons() {
    let copyButtonLabel = "Copy";
    let codeBlocks = Array.from(document.querySelectorAll("pre.astro-code"));

    for (let codeBlock of codeBlocks) {
      if (codeBlock.querySelector(".copy-code")) continue;

      let copyButton = document.createElement("button");
      copyButton.className = "copy-code";
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      let code = block.querySelector("code");
      let text = code.innerText;

      await navigator.clipboard.writeText(text);

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();
  document.addEventListener("astro:after-swap", attachCopyButtons);

  /** Highlights the section currently being read in the TOC rail. Runs at every
   * width even though the rail only shows above 1080px: gating on a media query
   * at load time would leave the rail dead if the window is later widened, and
   * one observer over a dozen headings costs nothing. */
  function trackReadingPosition() {
    const links = Array.from(document.querySelectorAll(".toc-rail a"));
    if (!links.length) return;

    const byId = new Map(
      links.map(link => [decodeURIComponent(link.hash.slice(1)), link])
    );
    const targets = Array.from(byId.keys())
      .map(id => document.getElementById(id))
      .filter(Boolean);
    if (!targets.length) return;

    let current = null;
    const setCurrent = link => {
      if (current === link) return;
      current?.removeAttribute("aria-current");
      link?.setAttribute("aria-current", "true");
      current = link;
    };

    // The last heading to have crossed the upper third of the viewport is the
    // one being read. A scroll listener rather than IntersectionObserver: with
    // IO, a section taller than the viewport can scroll past the threshold
    // without any heading entering or leaving it, and the highlight goes stale.
    const update = () => {
      const line = window.innerHeight * 0.35;
      let active = null;
      for (const el of targets) {
        if (el.getBoundingClientRect().top <= line) active = el;
        else break;
      }
      setCurrent(active ? byId.get(active.id) : links[0]);
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };

    // On a deep link the browser scrolls after this script parses, so measuring
    // now would report the top of the article. Trust the hash instead, and let
    // the first scroll take over from there.
    const linked =
      location.hash && byId.get(decodeURIComponent(location.hash.slice(1)));
    if (linked) setCurrent(linked);
    else update();

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    window.addEventListener("hashchange", () => {
      const target = byId.get(decodeURIComponent(location.hash.slice(1)));
      if (target) setCurrent(target);
    });
  }
  trackReadingPosition();
  document.addEventListener("astro:after-swap", trackReadingPosition);

  /** Scrolls the document to the top when
   * the "Back to Top" button is clicked. */
  function backToTop() {
    document.querySelector("#back-to-top")?.addEventListener("click", () => {
      document.body.scrollTop = 0; // For Safari
      document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    });
  }
  backToTop();
  document.addEventListener("astro:after-swap", backToTop);
</script>

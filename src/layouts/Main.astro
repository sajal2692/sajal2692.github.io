---
interface BaseProps {
  pageDesc?: string;
  /** Mono metadata line above the title; falsy entries are dropped. */
  kicker?: (string | false | undefined | null)[];
}

export interface Props extends BaseProps {
  pageTitle: string;
  /** View-transition name, when the title animates in from somewhere (a tag chip). */
  titleTransition?: string;
}

const { props } = Astro;
const kicker = (props.kicker ?? []).filter(Boolean) as string[];
---

<main id="main-content">
  <slot name="backlink" />
  <header class="page-head">
    {
      kicker.length > 0 && (
        <p class="page-kicker">
          {kicker.map(item => (
            <span>{item}</span>
          ))}
        </p>
      )
    }
    {
      props.titleTransition ? (
        <h1 class="page-title" transition:name={props.titleTransition}>
          {props.pageTitle}
        </h1>
      ) : (
        <h1 class="page-title">{props.pageTitle}</h1>
      )
    }
    {props.pageDesc && <p class="page-deck">{props.pageDesc}</p>}
  </header>
  <slot />
</main>

<style>
  /* Every list page — the archive, tags, a tag, search — shares this header, so
     they speak in the same voice as an article: mono kicker, serif title,
     upright deck. It was a 30px heading over an italic paragraph in a 768px
     column, which is most of why the lists read as a different site.
     The breadcrumb trail that used to sit above it is gone: at body size in
     sans it outweighed the kicker directly beneath it, and said the same thing
     the kicker and the header's active nav item already say. Pages that need a
     way back up put a post-page-style link in the `backlink` slot. */
  #main-content {
    @apply mx-auto w-full px-4 pt-8 pb-4;
    max-width: theme("maxWidth.measure");
  }
  .page-head {
    @apply mb-12;
  }
  .page-kicker {
    @apply mb-4 flex flex-wrap gap-x-2 gap-y-1 font-mono text-skin-muted;
    font-size: 0.8125rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .page-kicker span:not(:last-child)::after {
    content: " ·";
  }
  /* A step under a post title (which clamps to 46px): a list page announces
     itself without competing with the piece a reader came to read. */
  .page-title {
    @apply font-serif font-semibold;
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 0.85rem;
    text-wrap: balance;
  }
  .page-deck {
    @apply text-skin-muted;
    font-size: 1.25rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
</style>
